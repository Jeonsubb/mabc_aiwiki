generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 사용자 / 인증 ----------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("user") // 'user' | 'demo'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chats             Chat[]
  records           Record[]
  wikiNodes         WikiNode[]
  proposals         Proposal[]
  relationships     NodeRelationship[] @relation("UserRelationships")
  memorySlots       UserMemorySlot[]
  interestTrackings InterestTracking[]
  mcpCredentials    McpCredential[]

  @@map("users")
}

// ---------- 사용자별 MCP 연결 토큰 ----------
model McpCredential {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String   @unique
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@map("mcp_credentials")
}

// ---------- 챗 에이전트 대화 ----------
model Chat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
  segments ConversationSegment[]

  interestMentions InterestMention[]

  @@map("chats")
}

model ChatMessage {
  id         String   @id @default(uuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role       String // 'user' | 'agent'
  content    String
  toolCallId String?
  toolResult Json?
  createdAt  DateTime @default(now())

  segments ConversationSegment[]

  @@map("chat_messages")
}

// ---------- 입력 원본 + 대화 조각 ----------
model Record {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String // 어떤 대화/세션에서 왔는지 (chatId 또는 외부 대화ID)
  source         String // 'paste' | 'chat' | 'mcp'
  rawText        String
  contentHash    String // 사용자별 유일
  context        Json? // 주제/스킬/세션 등 메타
  status         String   @default("보관됨") // '보관됨' | '처리중' | '처리됨' | '실패'
  retryCount     Int      @default(0)
  errorMessage   String?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  segments         ConversationSegment[]
  proposals        Proposal[] // 이 record에서 파생된 제안
  nodeMappings     RecordToNode[]
  interestMentions InterestMention[]

  @@unique([userId, contentHash], name: "user_content_hash_unique")
  @@map("records")
}

model ConversationSegment {
  id            String       @id @default(uuid())
  recordId      String
  record        Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  chatId        String?
  chat          Chat?        @relation(fields: [chatId], references: [id], onDelete: SetNull)
  messageId     String?
  message       ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  segmentIndex  Int          @default(0)
  rawStart      Int // 원문 내 시작 오프셋
  rawEnd        Int // 원문 내 종료 오프셋
  rawText       String // 조각 텍스트 사본
  contextBefore String?
  contextAfter  String?
  skillName     String?
  createdAt     DateTime     @default(now())

  interestMentions  InterestMention[]
  proposalEvidences ProposalEvidence[]

  @@map("conversation_segments")
}

// ---------- 위키 노드 + 버전/갱신 이력 ----------
model WikiNode {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                    String
  summary                  String
  content                  String
  topics                   String[] // 사용자 지정 태그/분류
  tags                     String[] // 현재 effective 태그 (AI + 사용자 수정)
  categories               String[] // 현재 effective 분류 (AI + 사용자 수정)
  hiddenTags               String[] // AI 제안 중 사용자가 숨긴 태그
  hiddenCategories         String[] // AI 제안 중 사용자가 숨긴 분류
  status                   String   @default("활성") // '활성' | '분리됨' | '병합됨' | '분류대기'
  classificationState      String? // '확정' | '후보N개' | '미정'
  classificationCandidates String? // 후보 분류 목록
  latestVersion            Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  versions       NodeVersion[]
  toNodes        RecordToNode[]
  fromProps      Proposal[]         @relation("ProposalTarget")
  toProps        Proposal[]         @relation("ProposalSource")
  sourceNodeRels NodeRelationship[] @relation("SourceNodeRel")
  targetNodeRels NodeRelationship[] @relation("TargetNodeRel")

  @@map("wiki_nodes")
}

model NodeVersion {
  id             String         @id @default(uuid())
  nodeId         String
  node           WikiNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  recordMappings RecordToNode[]
  version        Int
  summary        String
  content        String
  topics         String[]
  tags           String[]
  categories     String[]
  changedBy      String         @default("user") // 'user' | 'agent' | 'system'
  changeType     String? // '생성' | '갱신' | '병합' | '분리' | '연결추가' | '수동편집' | '보강반영'
  changeNote     String?
  createdAt      DateTime       @default(now())

  @@unique([nodeId, version])
  @@map("node_versions")
}

// ---------- 제안 ----------
model Proposal {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String // '추가' | '갱신' | '분리' | '병합' | '연결' | '보강' | '수정'
  targetNodeId         String?
  targetNode           WikiNode? @relation("ProposalTarget", fields: [targetNodeId], references: [id], onDelete: SetNull)
  sourceNodeId         String?
  sourceNode           WikiNode? @relation("ProposalSource", fields: [sourceNodeId], references: [id], onDelete: SetNull)
  action               String // 구체적 행위 설명
  reason               String
  proposalHash         String    @unique // 멱등성용 해시
  evidenceSegmentIds   String[] // 증거 원문 segment id 배열
  relatedSegmentIds    String[] // 관련 conversation_segment id 배열
  relatedRecordId      String?
  relatedRecord        Record?   @relation(fields: [relatedRecordId], references: [id], onDelete: SetNull)
  baseNodeVersion      Int? // 제안 생성 시점의 대상 노드 버전
  skillHash            String? // 제안 생성 시 적용된 ai-wiki-SKILL.md 규칙 해시/버전
  hasSensitiveInfo     Boolean   @default(false) // 원본에 민감 정보가 포함되어 있었는지
  sensitiveInfoWarning String? // 민감 정보 경고 내용 (어떤 종류/범위인지)
  sensitiveInfoNodeIds String[]
  draftPayload         Json?    // 신규 노드(추가) 제안의 AI 초안 구조화된 payload
  changePayload        Json?    // 기존 노드 변경(갱신/수정 등) 제안의 구조화된 변경안 payload
  before               Json?     // 변경 전 노드 스냅샷 (하위 호환: 요약/본문 포함 가능)
  after                Json?     // 변경 후 노드 스냅샷 (하위 호환: 요약/본문 포함 가능)
  status               String    @default("제안됨") // '제안됨' | '승인됨' | '기각됨' | '반영됨'
  decisionAt           DateTime?
  decisionAction       String? // '수락' | '기각'
  idempotencyKey       String?   @unique // decide 엔드포인트 멱등성 키
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  evidence      ProposalEvidence[]
  relationships NodeRelationship[]

  @@map("proposals")
}

// ---------- 근거 검증 테이블 ----------
model ProposalEvidence {
  id            String              @id @default(uuid())
  proposalId    String
  proposal      Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  segmentId     String // conversation_segment id
  segment       ConversationSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  quote         String // 인용문
  originalStart Int // 원문 내 시작 위치
  originalEnd   Int // 원문 내 종료 위치
  verified      Boolean             @default(false) // 검증 여부
  verifiedAt    DateTime?
  createdAt     DateTime            @default(now())

  @@map("proposal_evidence")
}

// ---------- 관계 (옵시디언 그래프) ----------
model NodeRelationship {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("UserRelationships", fields: [userId], references: [id], onDelete: Cascade)
  sourceNodeId  String
  sourceNode    WikiNode  @relation("SourceNodeRel", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId  String
  targetNode    WikiNode  @relation("TargetNodeRel", fields: [targetNodeId], references: [id], onDelete: Cascade)
  relationType  String // '연관' | '상위/하위' | '이전/이후' | '갱신출처' 등
  description   String?
  evidence      String // 어떤 근거로 관계가 생겼는지
  autoGenerated Boolean   @default(false) // 자동 생성된 연결 후보인지
  proposedBy    String?
  proposal      Proposal? @relation(fields: [proposedBy], references: [id], onDelete: SetNull)
  status        String    @default("연결됨") // '연결됨' | '제안됨' | '기각됨'
  createdAt     DateTime  @default(now())

  @@unique([sourceNodeId, targetNodeId, relationType])
  @@map("node_relationships")
}

// ---------- 원본→노드 반영 추적 ----------
model RecordToNode {
  id                String       @id @default(uuid())
  recordId          String
  record            Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  nodeId            String
  node              WikiNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeVersionId     String?
  nodeVersion       NodeVersion? @relation(fields: [nodeVersionId], references: [id], onDelete: SetNull)
  changeDescription String // 어떤 변경이 있었는지
  reflectedAt       DateTime     @default(now())

  @@unique([recordId, nodeId])
  @@map("record_to_node")
}

// ---------- 관심사 추적 (단순화) ----------
model InterestTracking {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest           String // 정규화된 관심사 텍스트
  status             String    @default("미지정") // '미지정' | '추적중' | '보류' | '완료'
  isExplicitlyMarked Boolean   @default(false) // 사용자가 직접 관심사로 표시했는지
  explicitMarkedAt   DateTime?
  explicitMarkedBy   String? // 어떤 mentionId/recordId에서 지정됐는지
  firstDiscoveredAt  DateTime  @default(now())
  lastDiscoveredAt   DateTime  @default(now())
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  mentions InterestMention[]

  @@unique([userId, interest], name: "user_interest_unique")
  @@map("interest_trackings")
}

model InterestMention {
  id                 String               @id @default(uuid())
  interestTrackingId String
  interestTracking   InterestTracking     @relation(fields: [interestTrackingId], references: [id], onDelete: Cascade)
  recordId           String
  record             Record               @relation(fields: [recordId], references: [id], onDelete: Cascade)
  chatId             String?
  chat               Chat?                @relation(fields: [chatId], references: [id], onDelete: SetNull)
  segmentId          String?
  segment            ConversationSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  role               String // 'user' | 'agent'
  messageCreatedAt   DateTime? // 내부 챗 메시지 시각 (우선)
  occurredAt         DateTime? // 붙여넣기/MCP 실제 발생 시각
  mentionedAt        DateTime // 최종 실제 대화 날짜
  contextSnippet     String?
  isExplicitMark     Boolean              @default(false) // 사용자가 "이건 내 관심사" 직접 표시

  createdAt DateTime @default(now())

  @@map("interest_mentions")
}

// ---------- Hindsight 연동 지점 (후속) ----------
model UserMemorySlot {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotKey   String
  slotValue Json // retain/recall/reflect 구분 키 + 값
  source    String? // 'hindsight' | 'service' | 'user'
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, slotKey])
  @@map("user_memory_slots")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
