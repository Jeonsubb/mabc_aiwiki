generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String?
  passwordHash      String
  role              String             @default("user")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  chats             Chat[]
  interestTrackings InterestTracking[]
  relationships     NodeRelationship[] @relation("UserRelationships")
  proposals         Proposal[]
  records           Record[]
  memorySlots       UserMemorySlot[]
  wikiNodes         WikiNode[]
  mcpCredentials    McpCredential[]

  @@map("users")
}

// ---------- 사용자별 MCP 연결 토큰 ----------
model McpCredential {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String   @unique
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@map("mcp_credentials")
}

// ---------- 챗 에이전트 대화 ----------
model Chat {
  id               String                @id @default(uuid())
  userId           String
  title            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  messages         ChatMessage[]
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments         ConversationSegment[]
  interestMentions InterestMention[]

  @@map("chats")
}

model ChatMessage {
  id                 String   @id @default(uuid())
  chatId             String
  chat               Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role               String   // 'user' | 'assistant'
  content            String
  toolCallId         String?
  toolResult         Json?
  retryStatus        String?  // 'processing' | 'done' | 'failed'
  referencedMessageId String? // assistant 답변이 응답하는 사용자 메시지 id
  createdAt          DateTime @default(now())

  segments ConversationSegment[]

  @@map("chat_messages")
}

model Record {
  id               String                @id @default(uuid())
  userId           String
  conversationId   String
  source           String
  rawText          String
  contentHash      String
  context          Json?
  status           String                @default("보관됨")
  retryCount       Int                   @default(0)
  errorMessage     String?
  receivedAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  segments         ConversationSegment[]
  interestMentions InterestMention[]
  proposals        Proposal[]
  nodeMappings     RecordToNode[]
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentHash], name: "user_content_hash_unique")
  @@map("records")
}

model ConversationSegment {
  id                String             @id @default(uuid())
  recordId          String
  chatId            String?
  messageId         String?
  segmentIndex      Int                @default(0)
  rawStart          Int
  rawEnd            Int
  rawText           String
  contextBefore     String?
  contextAfter      String?
  skillName         String?
  createdAt         DateTime           @default(now())
  chat              Chat?              @relation(fields: [chatId], references: [id])
  message           ChatMessage?       @relation(fields: [messageId], references: [id])
  record            Record             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  interestMentions  InterestMention[]
  proposalEvidences ProposalEvidence[]

  @@map("conversation_segments")
}

model WikiNode {
  id                       String             @id @default(uuid())
  userId                   String
  title                    String
  summary                  String
  content                  String
  topics                   String[]
  tags                     String[]
  categories               String[]
  hiddenTags               String[]
  hiddenCategories         String[]
  status                   String             @default("활성")
  classificationState      String?
  classificationCandidates String?
  latestVersion            Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  sourceNodeRels           NodeRelationship[] @relation("SourceNodeRel")
  targetNodeRels           NodeRelationship[] @relation("TargetNodeRel")
  versions                 NodeVersion[]
  toProps                  Proposal[]         @relation("ProposalSource")
  fromProps                Proposal[]         @relation("ProposalTarget")
  toNodes                  RecordToNode[]
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wiki_nodes")
}

model NodeVersion {
  id             String         @id @default(uuid())
  nodeId         String
  version        Int
  summary        String
  content        String
  topics         String[]
  tags           String[]
  categories     String[]
  changedBy      String         @default("user")
  changeType     String?
  changeNote     String?
  createdAt      DateTime       @default(now())
  node           WikiNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  recordMappings RecordToNode[]

  @@unique([nodeId, version])
  @@map("node_versions")
}

model Proposal {
  id                   String             @id @default(uuid())
  userId               String
  type                 String
  targetNodeId         String?
  sourceNodeId         String?
  action               String
  reason               String
  proposalHash         String             @unique
  evidenceSegmentIds   String[]
  relatedSegmentIds    String[]
  relatedRecordId      String?
  baseNodeVersion      Int?
  skillHash            String?
  hasSensitiveInfo     Boolean            @default(false)
  sensitiveInfoWarning String?
  sensitiveInfoNodeIds String[]
  draftPayload         Json?    // 신규 노드(추가) 제안의 AI 초안 구조화된 payload
  changePayload        Json?    // 기존 노드 변경(갱신/수정 등) 제안의 구조화된 변경안 payload
  before               Json?     // 변경 전 노드 스냅샷 (하위 호환: 요약/본문 포함 가능)
  after                Json?     // 변경 후 노드 스냅샷 (하위 호환: 요약/본문 포함 가능)
  status               String    @default("제안됨") // '제안됨' | '승인됨' | '기각됨' | '반영됨'
  decisionAt           DateTime?
  decisionAction       String?
  idempotencyKey       String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  relationships        NodeRelationship[]
  evidence             ProposalEvidence[]
  relatedRecord        Record?            @relation(fields: [relatedRecordId], references: [id])
  sourceNode           WikiNode?          @relation("ProposalSource", fields: [sourceNodeId], references: [id])
  targetNode           WikiNode?          @relation("ProposalTarget", fields: [targetNodeId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("proposals")
}

model ProposalEvidence {
  id            String              @id @default(uuid())
  proposalId    String
  segmentId     String
  quote         String
  originalStart Int
  originalEnd   Int
  verified      Boolean             @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime            @default(now())
  proposal      Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  segment       ConversationSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@map("proposal_evidence")
}

model NodeRelationship {
  id            String    @id @default(uuid())
  userId        String
  sourceNodeId  String
  targetNodeId  String
  relationType  String
  description   String?
  evidence      String
  tags          String[]  @default([])
  autoGenerated Boolean   @default(false)
  proposedBy    String?
  status        String    @default("연결됨")
  createdAt     DateTime  @default(now())
  proposal      Proposal? @relation(fields: [proposedBy], references: [id])
  sourceNode    WikiNode  @relation("SourceNodeRel", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode    WikiNode  @relation("TargetNodeRel", fields: [targetNodeId], references: [id], onDelete: Cascade)
  user          User      @relation("UserRelationships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, relationType])
  @@map("node_relationships")
}

model RecordToNode {
  id                String       @id @default(uuid())
  recordId          String
  nodeId            String
  nodeVersionId     String?
  changeDescription String
  reflectedAt       DateTime     @default(now())
  node              WikiNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeVersion       NodeVersion? @relation(fields: [nodeVersionId], references: [id])
  record            Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, nodeId])
  @@map("record_to_node")
}

model InterestTracking {
  id                 String            @id @default(uuid())
  userId             String
  interest           String
  status             String            @default("미지정")
  isExplicitlyMarked Boolean           @default(false)
  explicitMarkedAt   DateTime?
  explicitMarkedBy   String?
  firstDiscoveredAt  DateTime          @default(now())
  lastDiscoveredAt   DateTime          @default(now())
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  mentions           InterestMention[]
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interest], name: "user_interest_unique")
  @@map("interest_trackings")
}

model InterestMention {
  id                 String               @id @default(uuid())
  interestTrackingId String
  recordId           String
  chatId             String?
  segmentId          String?
  role               String
  messageCreatedAt   DateTime?
  occurredAt         DateTime?
  mentionedAt        DateTime
  contextSnippet     String?
  isExplicitMark     Boolean              @default(false)
  createdAt          DateTime             @default(now())
  chat               Chat?                @relation(fields: [chatId], references: [id])
  interestTracking   InterestTracking     @relation(fields: [interestTrackingId], references: [id], onDelete: Cascade)
  record             Record               @relation(fields: [recordId], references: [id], onDelete: Cascade)
  segment            ConversationSegment? @relation(fields: [segmentId], references: [id])

  @@map("interest_mentions")
}

model UserMemorySlot {
  id        String    @id @default(uuid())
  userId    String
  slotKey   String
  slotValue Json
  source    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slotKey])
  @@map("user_memory_slots")
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}
